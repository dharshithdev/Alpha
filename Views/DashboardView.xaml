<Window x:Class="Alpha.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Billing System - Dashboard"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        MinHeight="600" MinWidth="1000">

    <Window.Resources>
        <!-- Shadow effect -->
        <DropShadowEffect x:Key="Shadow" BlurRadius="10" Opacity="0.08" ShadowDepth="2"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EBFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A5BD9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A4BC9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active Sidebar Button -->
        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#3A5BD9"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource Shadow}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C3E8A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Height="80" Background="#1E2F6F">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Alpha Billing" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="v2.0" Foreground="#8899C8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- User Info -->
                <Border Grid.Row="1" Height="70" Background="#1A2860" Margin="0,5">
                    <StackPanel VerticalAlignment="Center" Margin="15,0">
                        <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="UserRoleText" Foreground="#8899C8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="DashboardBtn" Click="DashboardBtn_Click" Style="{StaticResource ActiveSidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="16"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProductsBtn" Click="ProductsBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦 " FontSize="16"/>
                            <TextBlock Text="Products" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="InventoryBtn" Click="InventoryBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="16"/>
                            <TextBlock Text="Inventory" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="InvoicesBtn" Click="InvoicesBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾 " FontSize="16"/>
                            <TextBlock Text="Invoices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CustomersBtn" Click="CustomersBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="16"/>
                            <TextBlock Text="Customers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReportsBtn" Click="ReportsBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈 " FontSize="16"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UsersBtn" Click="UsersBtn_Click" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 " FontSize="16"/>
                            <TextBlock Text="Users" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Row="3" Click="LogoutBtn_Click" 
                        Background="#1A2860" Foreground="#E53E3E" 
                        Height="42" BorderThickness="0" Cursor="Hand" Margin="5,0,5,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚪 " FontSize="16"/>
                        <TextBlock Text="Logout" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Welcome Header -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="WelcomeText" FontSize="20" FontWeight="Bold" Foreground="#2D3748"/>
                        <TextBlock x:Name="RoleText" FontSize="13" Foreground="#718096" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Role Badge -->
                    <Border Grid.Column="1" x:Name="RoleBadge" Padding="12,5" CornerRadius="15" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="25">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ContentText" Text="Welcome to Alpha Billing System!" 
                               FontSize="16" Foreground="#2D3748"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>