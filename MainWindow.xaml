<Window x:Class="Alpha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Billing System - Login"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F6FA"
        MinHeight="400" MinWidth="550">

    <Window.Resources>
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Background" Value="#2C3E8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2F6F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#152050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A0AEC0"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2C3E8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2C3E8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Branding -->
        <Border Grid.Column="0" Background="#2C3E8A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" Background="White" CornerRadius="40" Margin="0,0,0,20">
                    <TextBlock Text="A" FontSize="40" FontWeight="Bold" 
                               Foreground="#2C3E8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Alpha Billing" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Pro" FontSize="16" Foreground="#A8B5E0" Margin="0,5,0,0"/>
                <TextBlock Text="Complete Billing Solution" FontSize="12" Foreground="#8899C8" Margin="0,15,0,0"/>
                <Border Height="2" Width="40" Background="#A8B5E0" Margin="0,15,0,0"/>
                <TextBlock Text="v2.0" FontSize="11" Foreground="#6B7DB3" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right Panel - Login Form -->
        <Grid Grid.Column="1" Margin="40,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome Back!" FontSize="22" FontWeight="Bold" Foreground="#2D3748"/>
                <TextBlock Text="Please sign in to continue" FontSize="13" Foreground="#718096" Margin="0,5,0,30"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" 
                           Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" 
                           Foreground="#4A5568" Margin="0,15,0,5"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBox}"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Foreground="#E53E3E" FontSize="12" 
                           Margin="0,10,0,0" Visibility="Collapsed"/>

                <!-- Buttons -->
                <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource LoginButton}"
                        Click="LoginButton_Click" Margin="0,20,0,0"/>
                <Button Content="Cancel" Background="#E2E8F0" Foreground="#4A5568" 
                        FontSize="14" FontWeight="SemiBold" Height="42" Cursor="Hand" 
                        BorderThickness="0" Click="CancelButton_Click" Margin="0,10,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D0D5DD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Demo Credentials Info -->
                <Border Background="#F0F4F8" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Demo Credentials:" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBlock Text="Manager: manager / manager123" FontSize="10" Foreground="#718096"/>
                        <TextBlock Text="Inventory: inventory / inventory123" FontSize="10" Foreground="#718096"/>
                        <TextBlock Text="Cashier: cashier / cashier123" FontSize="10" Foreground="#718096"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>